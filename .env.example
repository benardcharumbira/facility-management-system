# Base URL of the backend REST API (no trailing slash needed).
# When mocking is enabled, MSW intercepts requests to this URL.
VITE_API_BASE_URL=http://localhost:5000/api

# Clerk publishable key (Clerk dashboard > API keys). Must start with pk_.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# "true" serves GET /me and sample endpoints from MSW; "false" calls the real API.
VITE_ENABLE_API_MOCKING=true

# Optional. Role returned by the mocked GET /me:
# applicant | internal | facility_admin | system_admin (default: applicant)
VITE_MOCK_ROLE=applicant

# Optional. Which fixture the mocked facilities endpoints serve:
# real (the twelve confirmed Midvaal venues, default) | volume (generated, fictional, for
# testing pagination and filters at scale)
VITE_MOCK_DATASET=real

# Optional, development only. "false" hides the banner that flags provisional sample data.
# Production builds never show it.
VITE_SHOW_SAMPLE_DATA_BANNER=true
